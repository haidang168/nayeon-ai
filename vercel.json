{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/yt-transcript", "destination": "/api/yt-transcript" },
    { "source": "/api/yt-info", "destination": "/api/yt-info" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
